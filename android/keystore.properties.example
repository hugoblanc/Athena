# Copie ce fichier en `android/keystore.properties` (NON commité, gitignoré) puis
# renseigne tes valeurs pour signer la release via `./gradlew bundleRelease`.
#
# storeFile : chemin vers le keystore, relatif au dossier android/app/
#             (ex. ../../athena.keystore si le keystore est à la racine du projet).
storeFile=../athena.keystore
storePassword=TON_MOT_DE_PASSE_STORE
keyAlias=TON_ALIAS
keyPassword=TON_MOT_DE_PASSE_CLE
